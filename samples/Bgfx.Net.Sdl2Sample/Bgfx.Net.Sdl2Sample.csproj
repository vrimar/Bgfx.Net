<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bgfx.Net.Sdl2Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <NativeArtifactsDir Condition="'$(NativeArtifactsDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\native\</NativeArtifactsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.SDL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bgfx.Net\Bgfx.Net.csproj" />
  </ItemGroup>

  <!-- Stage the locally-built bgfx native lib next to the sample's output.
       ProjectReference doesn't pull native payloads the way a PackageReference
       to a packed .nupkg does, so the sample wouldn't otherwise find bgfx at
       runtime when developing in-tree. -->
  <ItemGroup>
    <None Include="$(NativeArtifactsDir)win-x64\bgfx.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)win-x64\bgfx.dll') and $([MSBuild]::IsOSPlatform('Windows'))" />
    <None Include="$(NativeArtifactsDir)linux-x64\libbgfx.so"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)linux-x64\libbgfx.so') and $([MSBuild]::IsOSPlatform('Linux'))" />
    <None Include="$(NativeArtifactsDir)osx-x64\libbgfx.dylib"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)osx-x64\libbgfx.dylib') and $([MSBuild]::IsOSPlatform('OSX'))" />
    <None Include="$(NativeArtifactsDir)osx-arm64\libbgfx.dylib"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Condition="Exists('$(NativeArtifactsDir)osx-arm64\libbgfx.dylib') and $([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

</Project>
