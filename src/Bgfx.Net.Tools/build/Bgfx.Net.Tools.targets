<Project>

  <!--
    Bgfx.Net.Tools — MSBuild integration for bgfx's shaderc/texturec/geometryc tools.

    Usage:
      <ItemGroup>
        <BgfxShader Include="shaders/vs_*.sc" Type="vertex" Platform="windows" Profile="s_5_0" Out="$(OutDir)shaders\%(Filename).bin" />
        <BgfxShader Include="shaders/fs_*.sc" Type="fragment" Platform="windows" Profile="s_5_0" Out="$(OutDir)shaders\%(Filename).bin" />
      </ItemGroup>

    Caveats:
      - HLSL/DXBC compilation runs Microsoft's d3dcompiler_47.dll: natively on a Windows host,
        and under Wine (wine on PATH) on a linux-x64 host, where the package ships it.
      - DXIL requires dxc.exe (cross-platform but distributed separately by Microsoft).
      - GLSL/ESSL/Metal/SPIR-V targets work cross-platform.
  -->

  <!-- The host's RID, not $(RuntimeIdentifier); an SDK may define it only after package props, so it resolves here. -->
  <PropertyGroup>
    <_BgfxNetToolsHostRid Condition="'$(_BgfxNetToolsHostRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_BgfxNetToolsHostRid>
    <_BgfxNetToolsRoot>$(MSBuildThisFileDirectory)..\runtimes\$(_BgfxNetToolsHostRid)\native\</_BgfxNetToolsRoot>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BgfxShaderC   Condition="'$(BgfxShaderC)' == ''">$(_BgfxNetToolsRoot)shaderc.exe</BgfxShaderC>
    <BgfxTextureC  Condition="'$(BgfxTextureC)' == ''">$(_BgfxNetToolsRoot)texturec.exe</BgfxTextureC>
    <BgfxGeometryC Condition="'$(BgfxGeometryC)' == ''">$(_BgfxNetToolsRoot)geometryc.exe</BgfxGeometryC>
  </PropertyGroup>

  <!-- NuGet unpacks an extensionless PackagePath as a folder, so outside Windows each tool sits in one of its own name. -->
  <PropertyGroup>
    <BgfxShaderC   Condition="'$(BgfxShaderC)' == ''">$(_BgfxNetToolsRoot)shaderc\shaderc</BgfxShaderC>
    <BgfxTextureC  Condition="'$(BgfxTextureC)' == ''">$(_BgfxNetToolsRoot)texturec\texturec</BgfxTextureC>
    <BgfxGeometryC Condition="'$(BgfxGeometryC)' == ''">$(_BgfxNetToolsRoot)geometryc\geometryc</BgfxGeometryC>
  </PropertyGroup>

  <Target Name="BgfxCompileShaders"
          BeforeTargets="AssignTargetPaths"
          Condition="'@(BgfxShader)' != ''"
          Inputs="@(BgfxShader)"
          Outputs="@(BgfxShader->'%(Out)')">

    <Error Code="BGFXNET100" Text="shaderc not found at $(BgfxShaderC). Set BgfxShaderC or ensure Bgfx.Net.Tools is restored for host RID '$(_BgfxNetToolsHostRid)'." Condition="!Exists('$(BgfxShaderC)')" />

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(BgfxShader.Out)'))" />

    <!-- Wine 11.10+ otherwise loads its own vkd3d d3dcompiler_47 in place of the shipped one. -->
    <!-- On Windows a trailing backslash before the closing quote escapes it, so -i swallows the quote. -->
    <Exec Command="&quot;$(BgfxShaderC)&quot; -f &quot;%(BgfxShader.FullPath)&quot; -o &quot;%(BgfxShader.Out)&quot; --type %(BgfxShader.Type) --platform %(BgfxShader.Platform) -p %(BgfxShader.Profile) -i &quot;$(BgfxShaderIncludePath.TrimEnd('\'))&quot;"
          EnvironmentVariables="WINEDLLOVERRIDES=d3dcompiler_47=n"
          ConsoleToMSBuild="true" />

    <ItemGroup>
      <Content Include="%(BgfxShader.Out)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
