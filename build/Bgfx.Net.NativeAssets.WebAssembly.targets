<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Ships under buildTransitive/netstandard1.0/ so it reaches consumers through
    a package reference. A .targets, not a .props: it imports after the project
    body, so RuntimeIdentifier is set when the conditions below evaluate.
    Archives sit alongside in bgfx.a/<emscripten-version>/,
    keyed by version because wasm objects only link against a .NET runtime pack
    built with the same emsdk.

    The archives are named without a lib prefix on purpose: the wasm pinvoke
    table matches [DllImport("bgfx")] against the archive's file stem.
  -->
  <PropertyGroup>
    <BgfxStaticLibraryPath>$(MSBuildThisFileDirectory)bgfx.a</BgfxStaticLibraryPath>
    <BgfxEmscriptenVersion Condition="'$(BgfxEmscriptenVersion)' == ''">6.0.2</BgfxEmscriptenVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <BgfxStaticLibrary Include="$(BgfxStaticLibraryPath)/$(BgfxEmscriptenVersion)/*.a" />
    <NativeFileReference Include="@(BgfxStaticLibrary)" />
  </ItemGroup>

  <!--
    The archives are built against webgpu.h but carry none of its implementation;
    the port supplies that, and it has to be on the link line as well as the
    compile line that produced them.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <EmccExtraLDFlags>$(EmccExtraLDFlags) --use-port=emdawnwebgpu</EmccExtraLDFlags>
  </PropertyGroup>

</Project>
