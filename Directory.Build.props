<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <Authors>Bgfx.Net contributors</Authors>
    <Company>Bgfx.Net</Company>
    <Copyright>Copyright (c) Bgfx.Net contributors</Copyright>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vrimar/Bgfx.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vrimar/Bgfx.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Surface the bundled bgfx API version on the gallery page. defines.h in the
       submodule is the single source of truth; BgfxBuildInfo exposes it in code. -->
  <PropertyGroup>
    <BgfxDefinesPath>$(MSBuildThisFileDirectory)external\bgfx\include\bgfx\defines.h</BgfxDefinesPath>
    <_BgfxDefinesText Condition="Exists('$(BgfxDefinesPath)')">$([System.IO.File]::ReadAllText('$(BgfxDefinesPath)'))</_BgfxDefinesText>
    <BgfxApiVersion Condition="'$(_BgfxDefinesText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_BgfxDefinesText), 'BGFX_API_VERSION\s+UINT32_C\((\d+)\)').Groups[1].Value)</BgfxApiVersion>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == '' and '$(BgfxApiVersion)' != ''">Bundles bgfx API v$(BgfxApiVersion). Exact upstream commit recorded in assembly metadata (BgfxRevision).</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md"               Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE"                 Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"  Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>

</Project>
